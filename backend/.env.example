# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas free tier recommended)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/blogapp?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/blogapp

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (for CORS)
# Example: http://localhost:5173,https://your-app.vercel.app
CLIENT_ORIGINS=http://localhost:5173
